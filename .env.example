# --- REQUIRED: Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_NOTIFICATION_CHAT_ID=123456789

# --- QUAD Application Settings ---
QUAD_MODE=bybit
QUAD_DRY_RUN=true
QUAD_DEFAULT_STRATEGY=trend_following
QUAD_HEALTH_PORT=9090
QUAD_CONFIG_PATH=config/config.yaml
QUAD_LOG_LEVEL=INFO
QUAD_LOG_FORMAT=json

# --- REQUIRED for Bybit mode (USDT perpetual / category=linear) ---
# BYBIT_TESTNET=true uses https://api-testnet.bybit.com (default, safe)
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=true

# --- REQUIRED for AI Trading Features ---
# Groq AI API key (for /analyze, /ai_strategy, trade rationale)
# Get your API key at https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here
# Optional: comma-separated pool; the client rotates to the next key when one
# hits a daily-quota wall instead of failing the cycle.
# GROQ_API_KEYS=gsk_key1,gsk_key2
QUAD_AI_ENABLED=true
QUAD_AI_MODEL=groq/compound-mini
QUAD_AI_TIMEOUT=30
QUAD_AI_MAX_REQUESTS_PER_DAY=950

# --- TradingView Webhook ---
# POST /webhook/tradingview is served on the HEALTH SERVER port above
# (QUAD_HEALTH_PORT=9090) -- it is a route, not a separate listener.
# QUAD_TRADINGVIEW_WEBHOOK_PORT is informational only.
QUAD_TRADINGVIEW_WEBHOOK_ENABLED=false
# A secret of at least 16 characters is REQUIRED whenever the webhook is
# enabled; the config schema rejects a shorter or missing one and the
# orchestrator refuses to arm the webhook (fail-closed). There is no
# unauthenticated mode.
QUAD_TRADINGVIEW_WEBHOOK_SECRET=

# --- Health / monitoring server ---
# Without this key the server binds to 127.0.0.1 and only accepts direct
# loopback requests. That bypass is REFUSED when reverse-proxy forwarding
# headers are present, so if you proxy this port you MUST set a key and send
# X-API-Key -- otherwise your own healthcheck gets 403.
# QUAD_HEALTH_API_KEY=

# --- Database ---
# Overrides persistence.dsn. Use a postgresql:// DSN for the asyncpg
# backend; anything else is treated as a SQLite path.
# DATABASE_URL=postgresql://quad:quad@postgres:5432/quad
# QUAD_DSN=data/quad.db

# --- Multi-tenancy (quad-api, Phase 1) ---
# Fernet key for Bybit credential encryption. Generate:
# python -c "from quad.security.secrets import generate_key; print(generate_key())"
QUAD_CREDENTIAL_KEY=replace_me_with_generated_key
# Postgres on Hetzner (docker-compose provides it); dev default stays SQLite
DATABASE_URL=postgresql://quad:quad@postgres:5432/quad
POSTGRES_PASSWORD=change_me
