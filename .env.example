# --- REQUIRED: PostgreSQL Database (asyncpg) ---
DATABASE_URL=postgresql://quad:quad@localhost:5432/quad

# --- REQUIRED: Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_NOTIFICATION_CHAT_ID=123456789

# --- QUAD Application Settings ---
QUAD_MODE=binance
QUAD_DRY_RUN=true
QUAD_DEFAULT_STRATEGY=trend_following
QUAD_HEALTH_PORT=9090
QUAD_CONFIG_DIR=config
QUAD_CONFIG_PATH=config/config.yaml
QUAD_MAX_CYCLE_INTERVAL=60
QUAD_LOG_LEVEL=INFO
QUAD_LOG_FORMAT=json

# --- REQUIRED for BINANCE mode ---
# Set BINANCE_TESTNET=true for testnet, false for live
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# --- REQUIRED for AI Trading Features ---
# Groq AI API key (for /analyze, /ai_strategy, trade rationale)
# Get your API key at https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here
QUAD_AI_ENABLED=false
QUAD_AI_MODEL=llama-3.3-70b-versatile
QUAD_AI_TIMEOUT=30
QUAD_AI_MAX_REQUESTS_PER_DAY=950

# --- TradingView Webhook ---
QUAD_TRADINGVIEW_WEBHOOK_ENABLED=false
QUAD_TRADINGVIEW_WEBHOOK_PORT=8081
QUAD_TRADINGVIEW_WEBHOOK_SECRET=

# --- Persistence ---
QUAD_DSN=postgresql://quad:quad@localhost:5432/quad
