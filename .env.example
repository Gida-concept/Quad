# --- REQUIRED: Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_NOTIFICATION_CHAT_ID=123456789

# --- QUAD Application Settings ---
QUAD_MODE=okx
QUAD_DRY_RUN=true
QUAD_DEFAULT_STRATEGY=trend_following
QUAD_HEALTH_PORT=9090
QUAD_CONFIG_PATH=config/config.yaml
QUAD_LOG_LEVEL=INFO
QUAD_LOG_FORMAT=json

# --- REQUIRED for OKX mode (USDT perpetual / instType=SWAP) ---
# Set OKX_TESTNET=true for demo, false for live
OKX_API_KEY=your_api_key_here
OKX_API_SECRET=your_api_secret_here
OKX_PASSPHRASE=your_passphrase_here
OKX_TESTNET=true

# --- REQUIRED for AI Trading Features ---
# Groq AI API key (for /analyze, /ai_strategy, trade rationale)
# Get your API key at https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here
QUAD_AI_ENABLED=true
QUAD_AI_MODEL=groq/compound-mini
QUAD_AI_TIMEOUT=30
QUAD_AI_MAX_REQUESTS_PER_DAY=950

# --- TradingView Webhook ---
QUAD_TRADINGVIEW_WEBHOOK_ENABLED=false
QUAD_TRADINGVIEW_WEBHOOK_PORT=8081
QUAD_TRADINGVIEW_WEBHOOK_SECRET=

# --- Tailscale VPN (routes bot traffic through non-US exit node) ---
# Get your auth key from https://login.tailscale.com/admin/acls/keys
TS_AUTHKEY=
# Set to false since we're using an existing exit node, not advertising ourselves
TS_ADVERTISE_EXIT_NODE=false
# IP of an existing non-US exit node in your tailnet (to route traffic through)
TS_EXIT_NODE_IP=
# Optional: tailnet name
TS_TAILNET=
